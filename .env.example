# Replace these placeholders in your local .env file or server environment.
MAIL_PROVIDER=smtp
EMAIL="your-sender@gmail.com"
EMAIL_PASS="your-16-character-app-password"

# Optional: destination inbox (defaults to EMAIL).
CONTACT_EMAIL="your-inbox@example.com"

# The contact form uses this API origin when it is set.
VITE_API_URL="https://myportfoliobackend-rfum.onrender.com"
# FRONTEND_URL="https://your-portfolio.example"

# Optional: hosting platforms set PORT automatically.
# PORT=3001